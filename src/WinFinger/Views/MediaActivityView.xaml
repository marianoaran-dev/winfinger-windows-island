<UserControl x:Class="WinFinger.Views.MediaActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <!-- DynamicNotch-style compact player: artwork, title/artist, status glyph. -->
        <Grid x:Name="CompactLayout" Margin="10,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Background="#161616">
                <Grid>
                    <Image x:Name="CompactCover" Stretch="UniformToFill"/>
                    <TextBlock x:Name="CompactCoverFallback" Text="♪" FontSize="20" Foreground="#BFFFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                <TextBlock x:Name="CompactTitle" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompactArtist" Foreground="#99FFFFFF" FontSize="11" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="30" Height="30" Fill="#12FFFFFF"/>
                <TextBlock x:Name="PlaybackGlyph" Text="▶" Foreground="White" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Expanded player deliberately remains compact, not a dashboard. -->
        <Grid x:Name="ExpandedLayout" Margin="18" Visibility="Collapsed" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="144" Height="144" CornerRadius="22"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Background="#161616">
                <Grid>
                    <Image x:Name="ExpandedCover" Stretch="UniformToFill"/>
                    <TextBlock x:Name="ExpandedCoverFallback" Text="♪" FontSize="42" Foreground="#BFFFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="18,4,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ExpandedTitle" Grid.Row="0" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ExpandedArtist" Grid.Row="1" Foreground="#A6FFFFFF" FontSize="13" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="48" Height="38" Margin="0,0,12,0" Click="OnPrevious" Content="⏮"
                            Foreground="White" Background="#14FFFFFF" BorderBrush="#20FFFFFF"/>
                    <Button x:Name="PlayPauseButton" Width="58" Height="42" Click="OnPlayPause" Content="▶"
                            Foreground="White" Background="#20FFFFFF" BorderBrush="#30FFFFFF" FontSize="16"/>
                    <Button Width="48" Height="38" Margin="12,0,0,0" Click="OnNext" Content="⏭"
                            Foreground="White" Background="#14FFFFFF" BorderBrush="#20FFFFFF"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
