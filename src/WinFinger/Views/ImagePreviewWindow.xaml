<Window x:Class="WinFinger.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image preview"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="#C8000000" Topmost="True" ShowInTaskbar="False"
        WindowState="Maximized"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnBackdropDown"
        MouseLeftButtonUp="OnBackdropUp"
        MouseMove="OnMouseMoveWin"
        MouseWheel="OnWheel">
    <Grid>
        <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
               MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="Pan"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" Foreground="#B0FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                   IsHitTestVisible="False"/>

        <Button Content="✕" Width="34" Height="34" FontSize="15" Cursor="Hand"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0"
                Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                Click="OnClose">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
