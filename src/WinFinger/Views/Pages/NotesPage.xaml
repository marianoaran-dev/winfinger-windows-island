<UserControl x:Class="WinFinger.Views.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinFinger.Controls"
             xmlns:models="clr-namespace:WinFinger.Models">
    <UserControl.Resources>
        <controls:RelativeTimeConverter x:Key="RelativeTime"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left: note list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <TextBlock Style="{StaticResource Text.Title}" Text="Sticky Notes" VerticalAlignment="Center"/>
                <Button x:Name="NewButton" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                        Content="＋ New" FontSize="12"/>
            </Grid>
            <ListBox x:Name="NoteList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Resources>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource Scroll.Dark}"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="10" Margin="0,0,6,4" Padding="10,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.Surface}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Note}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Micro}" Foreground="{StaticResource Brush.Orange}"
                                           Text="📌 " Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisible}}"/>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                           Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Micro}" Foreground="{StaticResource Brush.TextTertiary}"
                                       Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- right: editor -->
        <Grid Grid.Column="2">
            <Grid x:Name="EditorPane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="TitleBox" Style="{StaticResource TextBox.Dark}" FontSize="15" FontWeight="SemiBold"
                             Margin="0,0,116,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource Button.Ghost}" Content="Pin" FontSize="12"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource Button.Ghost}" Content="Delete" FontSize="12" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="BodyBox" Grid.Row="1" Style="{StaticResource TextBox.Dark}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </Grid>
            <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Select or create a note (Ctrl+N)"/>
        </Grid>
    </Grid>
</UserControl>
