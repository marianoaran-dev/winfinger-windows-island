<UserControl x:Class="WinFinger.Views.Pages.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinFinger.Controls"
             xmlns:models="clr-namespace:WinFinger.Models">
    <UserControl.Resources>
        <controls:RelativeTimeConverter x:Key="RelativeTime"/>
        <controls:ImagePathToThumbnailConverter x:Key="Thumbnail"/>
        <controls:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Style="{StaticResource Text.Title}" Text="剪贴板历史" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PauseButton" Style="{StaticResource Button.Ghost}" Content="暂停记录" FontSize="12"/>
                <Button x:Name="ClearButton" Style="{StaticResource Button.Ghost}" Content="清空" FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- entries -->
        <ListBox x:Name="EntryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.Resources>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource Scroll.Dark}"/>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="12" Margin="0,0,6,4" Padding="12,9">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.Surface}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- text entry -->
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Text}"
                                       Visibility="{Binding Text, Converter={StaticResource NullToCollapsed}}"
                                       TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap"/>
                            <!-- image entry -->
                            <Border CornerRadius="8" HorizontalAlignment="Left" ClipToBounds="True"
                                    Cursor="Hand" Background="#01000000"
                                    Tag="{Binding}" MouseLeftButtonUp="OnPreviewImage"
                                    ToolTip="点击放大查看"
                                    Visibility="{Binding ImagePath, Converter={StaticResource NullToCollapsed}}">
                                <Image Source="{Binding ImagePath, Converter={StaticResource Thumbnail}}"
                                       MaxHeight="72" MaxWidth="220" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Text.Micro}" Foreground="{StaticResource Brush.TextTertiary}"
                                           Text="{Binding SourceAppName}"
                                           Visibility="{Binding SourceAppName, Converter={StaticResource NullToCollapsed}}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource Text.Micro}" Foreground="{StaticResource Brush.TextTertiary}"
                                           Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Content="复制" FontSize="11"
                                    Click="OnCopyEntry" Tag="{Binding}"/>
                            <Button Style="{StaticResource Button.Ghost}" Content="删除" FontSize="11" Margin="2,0,0,0"
                                    Click="OnDeleteEntry" Tag="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyHint" Grid.Row="1" Style="{StaticResource Text.Secondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="复制点什么，历史会出现在这里" Visibility="Collapsed"/>
    </Grid>
</UserControl>
