<UserControl x:Class="WinFinger.Views.Pages.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- no session -->
        <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Secondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Nothing is playing"/>

        <!-- now playing -->
        <StackPanel x:Name="PlayerPane" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Width="148" Height="148" CornerRadius="18" HorizontalAlignment="Center"
                    Background="{StaticResource Brush.Surface}" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <TextBlock x:Name="CoverPlaceholder" FontFamily="Segoe Fluent Icons" FontSize="44" Text="&#xE93C;"
                               Foreground="{StaticResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="CoverImage" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,148,148" RadiusX="18" RadiusY="18"/>
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>

            <TextBlock x:Name="TitleLabel" Style="{StaticResource Text.Title}" FontSize="17"
                       HorizontalAlignment="Center" Margin="0,18,0,2" MaxWidth="420"
                       TextTrimming="CharacterEllipsis" Text=""/>
            <TextBlock x:Name="ArtistLabel" Style="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" Text=""/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="PrevButton" Style="{StaticResource Button.Ghost}" Padding="14,10">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE892;"/>
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource Button.Ghost}" Margin="10,0" Padding="16,10">
                    <TextBlock x:Name="PlayPauseGlyph" FontFamily="Segoe Fluent Icons" FontSize="26" Text="&#xE768;"/>
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource Button.Ghost}" Padding="14,10">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE893;"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
