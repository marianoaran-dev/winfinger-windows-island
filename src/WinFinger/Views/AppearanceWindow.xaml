<Window x:Class="WinFinger.Views.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFinger Appearance"
        Width="430" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnDragWindow">

    <Border CornerRadius="16" Background="#F2141419" BorderThickness="1.2"
            BorderBrush="{StaticResource Brush.GlassRim}">
        <DockPanel Margin="20,14,20,18">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Brush.TextSecondary}" Cursor="Hand"
                        Click="OnClose"/>
            </Grid>

            <Button DockPanel.Dock="Bottom" Content="Restore defaults" Height="32" Margin="0,12,0,0"
                    Background="{StaticResource Brush.Surface}" BorderThickness="0"
                    Foreground="{StaticResource Brush.TextPrimary}" Cursor="Hand"
                    Click="OnResetDefaults"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- background mode -->
                    <TextBlock Text="Background" Style="{StaticResource Text.SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                        <RadioButton x:Name="ModeGlass" Content="Live glass" Checked="OnModeChanged"
                                     Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,14,0"/>
                        <RadioButton x:Name="ModeColor" Content="Solid colour" Checked="OnModeChanged"
                                     Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,14,0"/>
                        <RadioButton x:Name="ModeImage" Content="Image" Checked="OnModeChanged"
                                     Foreground="{StaticResource Brush.TextPrimary}"/>
                    </StackPanel>

                    <!-- color picker -->
                    <StackPanel x:Name="ColorPanel" Margin="0,6,0,0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HexBox" Grid.Column="0" Style="{StaticResource TextBox.Dark}"
                                     Text="#1A1A22" KeyDown="OnHexKeyDown" VerticalContentAlignment="Center"/>
                            <Border x:Name="ColorPreview" Grid.Column="1" Width="34" Height="26" Margin="8,0,0,0"
                                    CornerRadius="6" Background="#1A1A22"
                                    BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"/>
                        </Grid>
                        <TextBlock Text="Hue" Style="{StaticResource Text.SmallLabel}"/>
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" ValueChanged="OnHsvChanged"/>
                        <TextBlock Text="Saturation" Style="{StaticResource Text.SmallLabel}"/>
                        <Slider x:Name="SatSlider" Minimum="0" Maximum="1" ValueChanged="OnHsvChanged"/>
                        <TextBlock Text="Brightness" Style="{StaticResource Text.SmallLabel}"/>
                        <Slider x:Name="ValSlider" Minimum="0" Maximum="1" ValueChanged="OnHsvChanged"/>
                        <WrapPanel x:Name="SwatchPanel" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- image picker -->
                    <StackPanel x:Name="ImagePanel" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ImagePathText" Grid.Column="0" Text="No image selected"
                                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Choose image…" Padding="10,4" Margin="8,0,0,0"
                                    Background="{StaticResource Brush.Surface}" BorderThickness="0"
                                    Foreground="{StaticResource Brush.TextPrimary}" Cursor="Hand"
                                    Click="OnPickImage"/>
                        </Grid>
                        <TextBlock Text="Image dimming" Style="{StaticResource Text.SmallLabel}"/>
                        <Slider x:Name="DimSlider" Minimum="0" Maximum="0.8" ValueChanged="OnTuneChanged"/>
                    </StackPanel>

                    <!-- glass tuning -->
                    <TextBlock Text="Glass" Style="{StaticResource Text.SectionLabel}" Margin="0,14,0,0"/>
                    <TextBlock Text="Glass darkness" Style="{StaticResource Text.SmallLabel}"/>
                    <Slider x:Name="DarkSlider" Minimum="0" Maximum="1" ValueChanged="OnTuneChanged"/>
                    <TextBlock x:Name="SatLabel" Text="Capture saturation" Style="{StaticResource Text.SmallLabel}"/>
                    <Slider x:Name="GlassSatSlider" Minimum="1.0" Maximum="2.2" ValueChanged="OnTuneChanged"/>

                    <TextBlock Text="Idle fade opacity (1 = no fade)" Style="{StaticResource Text.SmallLabel}"/>
                    <Slider x:Name="GhostSlider" Minimum="0.1" Maximum="1.0" ValueChanged="OnTuneChanged"/>

                    <TextBlock Text="Lighting effects" Style="{StaticResource Text.SectionLabel}" Margin="0,14,0,0"/>
                    <CheckBox x:Name="GlintCheck" Content="Breathing edge glow" Margin="0,6,0,2"
                              Foreground="{StaticResource Brush.TextPrimary}" Checked="OnTuneChanged" Unchecked="OnTuneChanged"/>
                    <CheckBox x:Name="ChromaCheck" Content="Chromatic edge" Margin="0,4,0,0"
                              Foreground="{StaticResource Brush.TextPrimary}" Checked="OnTuneChanged" Unchecked="OnTuneChanged"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
