<UserControl x:Class="WinFinger.Views.ExpandedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,12,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: tab pills -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="TabClipboard" Style="{StaticResource Button.TabPill}" Content="Clipboard" GroupName="Pages"/>
                <RadioButton x:Name="TabMedia" Style="{StaticResource Button.TabPill}" Content="Media" GroupName="Pages" Margin="4,0,0,0"/>
                <RadioButton x:Name="TabNotes" Style="{StaticResource Button.TabPill}" Content="Notes" GroupName="Pages" Margin="4,0,0,0"/>
                <RadioButton x:Name="TabShortcuts" Style="{StaticResource Button.TabPill}" Content="Shortcuts" GroupName="Pages" Margin="4,0,0,0"/>
                <RadioButton x:Name="TabPomodoro" Style="{StaticResource Button.TabPill}" Content="Pomodoro" GroupName="Pages" Margin="4,0,0,0"/>
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Content="✕" FontSize="11" Padding="8,4"/>
        </Grid>

        <!-- Page host -->
        <ContentControl x:Name="PageHost" Grid.Row="1"/>
    </Grid>
</UserControl>
