<UserControl x:Class="WinFinger.Views.ClipboardActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False">
    <Grid>
        <Grid x:Name="CompactLayout" Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewTile"
                    Width="54" Height="54"
                    CornerRadius="14"
                    Background="#181818"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="ImagePreview"
                           Stretch="UniformToFill"
                           Visibility="Collapsed"/>
                    <TextBlock x:Name="ClipboardGlyph"
                               Text="⌘"
                               Foreground="#F4F4F4"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText"
                           Text="Copied"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PreviewText"
                           Margin="0,4,0,0"
                           Foreground="#BFFFFFFF"
                           FontSize="11.5"
                           LineHeight="16"
                           MaxHeight="48"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SourceText"
                           Margin="0,4,0,0"
                           Foreground="#72FFFFFF"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ExpandedLayout" Margin="14,12" Visibility="Collapsed" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Screenshot"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Swipe up to dismiss"
                           Foreground="#66FFFFFF"
                           FontSize="9.5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,10,0,8"
                    CornerRadius="18"
                    Background="#111111"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="ExpandedImagePreview" Stretch="Uniform"/>
                    <StackPanel x:Name="ExpandedImageFallback"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="▧"
                                   Foreground="#88FFFFFF"
                                   FontSize="30"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Screenshot preview unavailable"
                                   Margin="0,8,0,0"
                                   Foreground="#88FFFFFF"
                                   FontSize="10.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="ExpandedSourceText"
                       Grid.Row="2"
                       Foreground="#72FFFFFF"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</UserControl>