<UserControl x:Class="WinFinger.Views.ClipboardActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False">
    <Grid Margin="14,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="PreviewTile"
                Width="54" Height="54"
                CornerRadius="14"
                Background="#181818"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                VerticalAlignment="Center"
                ClipToBounds="True">
            <Grid>
                <Image x:Name="ImagePreview"
                       Stretch="UniformToFill"
                       Visibility="Collapsed"/>
                <TextBlock x:Name="ClipboardGlyph"
                           Text="⌘"
                           Foreground="#F4F4F4"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock x:Name="HeadingText"
                       Text="Copied"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="PreviewText"
                       Margin="0,4,0,0"
                       Foreground="#BFFFFFFF"
                       FontSize="11.5"
                       LineHeight="16"
                       MaxHeight="48"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SourceText"
                       Margin="0,4,0,0"
                       Foreground="#72FFFFFF"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</UserControl>