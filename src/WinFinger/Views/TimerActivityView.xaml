<UserControl x:Class="WinFinger.Views.TimerActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid x:Name="CompactLayout" Margin="12,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="19" Background="#20FF9F0A" VerticalAlignment="Center">
                <TextBlock Text="◷" Foreground="#FFFFB340" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="CompactPhase" Foreground="#A6FFFFFF" FontSize="10"/>
                <TextBlock x:Name="CompactTime" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="CompactStatus" Grid.Column="2" Foreground="#80FFFFFF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="ExpandedLayout" Margin="20,16" Visibility="Collapsed" Opacity="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="ExpandedPhase" Foreground="#A6FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ExpandedTime" Grid.Row="1" Foreground="White" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
            <ProgressBar x:Name="TimerProgress" Grid.Row="2" Height="4" Minimum="0" Maximum="1" Background="#26FFFFFF" Foreground="#FFFF9F0A" BorderThickness="0"/>
            <TextBlock x:Name="SessionCount" Grid.Row="3" Foreground="#70FFFFFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrimaryButton" Width="94" Height="34" Click="OnPrimary" Foreground="White" Background="#20FFFFFF" BorderBrush="#30FFFFFF"/>
                <Button Width="72" Height="34" Margin="10,0,0,0" Click="OnReset" Content="Reset" Foreground="#BFFFFFFF" Background="#12FFFFFF" BorderBrush="#24FFFFFF"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>