<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Colors ═══ -->
    <Color x:Key="Color.IslandBlack">#FF060606</Color>
    <Color x:Key="Color.IslandBlackDeep">#FF000000</Color>
    <Color x:Key="Color.Surface">#FF111114</Color>
    <Color x:Key="Color.SurfaceHover">#FF1C1C21</Color>
    <Color x:Key="Color.Accent">#FF0A84FF</Color>
    <Color x:Key="Color.Green">#FF30D158</Color>
    <Color x:Key="Color.Orange">#FFFF9F0A</Color>
    <Color x:Key="Color.Red">#FFFF453A</Color>
    <Color x:Key="Color.TextPrimary">#FFF5F5F7</Color>
    <Color x:Key="Color.TextSecondary">#FF98989F</Color>
    <Color x:Key="Color.TextTertiary">#FF5B5B63</Color>

    <SolidColorBrush x:Key="Brush.Island" Color="{StaticResource Color.IslandBlack}"/>
    <!-- translucent white glass layers (desktop shows through the island behind them) -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}"/>
    <SolidColorBrush x:Key="Brush.Orange" Color="{StaticResource Color.Orange}"/>
    <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource Color.Red}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.Stroke" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#0DFFFFFF"/>

    <!-- ═══ Liquid Glass material ═══ -->

    <!-- Smoked glass tint over the acrylic-blur backdrop window; kept light so the blur shows -->
    <LinearGradientBrush x:Key="Brush.IslandBody" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4614141C" Offset="0"/>
        <GradientStop Color="#520E0E16" Offset="0.35"/>
        <GradientStop Color="#600A0A12" Offset="1"/>
    </LinearGradientBrush>

    <!-- Lens rim lit from the top-left, fading clockwise (single soft light source) -->
    <LinearGradientBrush x:Key="Brush.GlassRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#92FFFFFF" Offset="0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.35"/>
        <GradientStop Color="#16FFFFFF" Offset="0.7"/>
        <GradientStop Color="#26FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Inner dark edge: simulates the glass thickness below the rim -->
    <LinearGradientBrush x:Key="Brush.GlassInnerEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38000000" Offset="0"/>
        <GradientStop Color="#14000000" Offset="0.5"/>
        <GradientStop Color="#28000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Curved top reflection: stretches over the island, gone by ~45% height -->
    <LinearGradientBrush x:Key="Brush.TopSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0"/>
        <GradientStop Color="#0CFFFFFF" Offset="0.18"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>

    <!-- Breathing rim glints: light travels around the glass edge (opacity-animated in code) -->
    <LinearGradientBrush x:Key="Brush.GlintTopLeft" StartPoint="0,0" EndPoint="0.75,0.95">
        <GradientStop Color="#B4FFFFFF" Offset="0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.22"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlintBottomRight" StartPoint="1,1" EndPoint="0.25,0.05">
        <GradientStop Color="#7ACFE8FF" Offset="0"/>
        <GradientStop Color="#1ECFE8FF" Offset="0.25"/>
        <GradientStop Color="#00CFE8FF" Offset="0.55"/>
    </LinearGradientBrush>

    <!-- Chromatic dispersion edge: faint cyan→amber refraction along opposite corners -->
    <LinearGradientBrush x:Key="Brush.ChromaticEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E6FD8FF" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.32"/>
        <GradientStop Color="#00000000" Offset="0.68"/>
        <GradientStop Color="#28FFB35C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Diagonal sheen band that sweeps across on expand/notify -->
    <LinearGradientBrush x:Key="Brush.SheenSweep" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#2AFFFFFF" Offset="0.45"/>
        <GradientStop Color="#3EFFFFFF" Offset="0.5"/>
        <GradientStop Color="#2AFFFFFF" Offset="0.55"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ Typography ═══ -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Code, Consolas</FontFamily>

    <!-- ═══ Metrics ═══ -->
    <Duration x:Key="Anim.Expand">0:0:0.28</Duration>
    <Duration x:Key="Anim.Collapse">0:0:0.18</Duration>

    <!-- ═══ Common styles ═══ -->

    <Style x:Key="Text.Micro" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="Text.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="Text.SmallLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/>
        <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    </Style>

    <!-- Ghost icon button (round hover backplate) -->
    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- Pill tab button -->
    <Style x:Key="Button.TabPill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="14" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal dark vertical scrollbar -->
    <Style x:Key="ScrollBar.Slim" TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#33FFFFFF" CornerRadius="3" Width="6"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Scroll.Dark" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource ScrollBar.Slim}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark text box -->
    <Style x:Key="TextBox.Dark" TargetType="TextBox">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="SelectionBrush" Value="#550A84FF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10"
                            BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
